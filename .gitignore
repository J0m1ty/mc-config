# Allowlist: only configuration is tracked. Worlds, player data, jars,
# logs and generated keys stay out (worlds live in backups, jars in plugins.md).
/*
!/.gitignore
!/README.md
!/plugins.md
!/start.sh
!/ecosystem.config.cjs
!/*.properties
!/*.yml
!/eula.txt
!/server-icon.png
!/ops.json
!/whitelist.json
!/config/
!/plugins/
/plugins/*.jar
/plugins/.paper-remapped/
/plugins/**/libs/
/plugins/**/translations/
/plugins/**/*.db
/plugins/**/*.pem
/plugins/**/*keystore*
/plugins/**/userdata*/
/plugins/**/logs/
/plugins/**/tmp*/
/plugins/Chunky/tasks/
/plugins/Essentials/items.json
/plugins/Essentials/messages/
/plugins/Essentials/upgrades-done.yml
/plugins/InvSeePlusPlus/InvSee++/
/plugins/SetHome/
/plugins/TAB/playerdata.yml
/plugins/TAB/skincache.yml
/plugins/TAB/users.yml
/plugins/X-Commands/guides/
/plugins/X-Commands/languages/
